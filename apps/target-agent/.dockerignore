# target-agent .dockerignore — keeps build context small + secret-safe.
#
# Without this, `docker build` would COPY the entire .venv/, .git/, tests/,
# and any .env files into the build context — slowing builds, bloating the
# image cache, and risking secret leakage. The workspace-root .dockerignore
# (if present) takes precedence for root-context builds; this one acts as
# the per-app safety net.

# Python build artifacts
__pycache__
*.pyc
*.pyo
*.pyd
*.egg-info
*.egg

# Tool caches
.pytest_cache
.mypy_cache
.ruff_cache
.ty_cache

# Virtual environments — always built fresh inside the image
.venv

# Tests — runtime image must not ship test code or fixtures (saves ~MB +
# tightens supply chain)
tests

# Documentation — workspace-level docs/ stays out of the build context.
# README.md files DO need to be allowed because uv reads [project.readme]
# at install time; excluding them breaks `uv sync`.
docs

# Local-only artifacts
.env
.env.*
.DS_Store

# Source control
.git
.gitignore

# Coverage + build outputs
htmlcov
.coverage
.coverage.*
dist
build
