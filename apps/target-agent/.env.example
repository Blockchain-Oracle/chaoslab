# target-agent environment variables.
#
# Local dev: copy to apps/target-agent/.env and `direnv allow` (or `source`).
# Cloud Run: set via deploy command; PHOENIX_API_KEY comes from Secret Manager.

# Phoenix Cloud credentials (LOCAL DEV)
# Planned for S2.4 (Cloud Run deploy): pull from Google Secret Manager
# (secret name: phoenix-api-key) under GCP_PROJECT_ID. Leave PHOENIX_API_KEY
# blank to force the Secret Manager path on Cloud Run.
PHOENIX_API_KEY=

# Phoenix Cloud collector endpoint. The space-scoped URL (with /s/<space>) may
# be required if the integration test returns 404 on span ingestion — see the
# coding-agent note in story-2.3.
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com

# Phoenix project name. MUST match across:
#   - apps/target-agent/src/target_agent/observability.py default
#   - Phoenix Audit orchestrator --project flag (Epic 4)
#   - Demo UI deep-link to https://app.phoenix.arize.com/projects/<name>
PHOENIX_PROJECT_NAME=target-agent

# Google Cloud project — used to resolve PHOENIX_API_KEY from Secret Manager
# when PHOENIX_API_KEY env var is unset. Required in Cloud Run; optional locally.
GCP_PROJECT_ID=

# PUBLIC_URL fixes issue #22. Without it, the A2A agent card advertises
# http://localhost:8001 regardless of where the container actually binds —
# so the orchestrator's `RemoteA2aAgent` client dispatches messages to
# localhost and every audit baseline fails 0/5. Cloud Run set this to the
# service URL (e.g. https://target-agent-xxxxx.run.app). Leave empty for
# local dev (the localhost default is correct there).
PUBLIC_URL=

# A2A server bind config. Cloud Run injects $PORT (typically 8080) at runtime.
PORT=8001
HOST=0.0.0.0

# Local-dev GCP auth. For most workflows `gcloud auth application-default
# login` is enough; this is the escape hatch when you want to test the
# Secret Manager fallback path with a specific SA key.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# Set to 1 to opt-in to the no-op graceful-degradation path when Phoenix
# credentials are missing on Cloud Run (K_SERVICE is set). Local dev default
# is graceful-degradation always; Cloud Run default is fail-loud.
# PHOENIX_OBSERVABILITY_OPTIONAL=1
