# target-agent environment variables.
#
# Local dev: copy to apps/target-agent/.env and `direnv allow` (or `source`).
# Cloud Run: set via deploy command; PHOENIX_API_KEY comes from Secret Manager.

# Phoenix Cloud credentials (LOCAL DEV)
# In production these come from Google Secret Manager (secret: phoenix-api-key)
# under GCP_PROJECT_ID. Leave PHOENIX_API_KEY blank to force Secret Manager path.
PHOENIX_API_KEY=

# Phoenix Cloud collector endpoint. The space-scoped URL (with /s/<space>) may
# be required if the integration test returns 404 on span ingestion — see the
# coding-agent note in story-2.3.
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com

# Phoenix project name. MUST match across:
#   - apps/target-agent/src/target_agent/observability.py default
#   - Phoenix Audit orchestrator --project flag (Epic 4)
#   - Demo UI deep-link to https://app.phoenix.arize.com/projects/<name>
PHOENIX_PROJECT_NAME=target-agent

# Google Cloud project — used to resolve PHOENIX_API_KEY from Secret Manager
# when PHOENIX_API_KEY env var is unset. Required in Cloud Run; optional locally.
GCP_PROJECT_ID=

# A2A server bind config. Cloud Run injects $PORT (typically 8080) at runtime.
PORT=8001
HOST=0.0.0.0
