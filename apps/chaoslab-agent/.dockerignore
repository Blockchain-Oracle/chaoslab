# Build context lives at workspace root (per Dockerfile header), so this file
# governs what is excluded from the COPY layers when the build looks inside
# `apps/chaoslab-agent/`. Keep slim: never bake env files, caches, or tests
# into the runtime image.

# Python build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg

# Test + coverage outputs
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ty_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# Virtual envs — the runtime image builds its own under /opt/venv
.venv/
venv/

# Tests not needed at runtime
tests/

# Env files — NEVER bake secrets into the image
.env
.env.*

# IDE / OS noise
.idea/
.vscode/
*.swp
.DS_Store

# Build infra in the package — referenced from the Dockerfile via the workspace
# root context, so excluding from app-local copies prevents accidental dup.
Dockerfile
.dockerignore

# Docs not needed at runtime (the build stage copies README.md explicitly for
# hatchling, but other markdown is excluded).
CHANGELOG.md
docs/
