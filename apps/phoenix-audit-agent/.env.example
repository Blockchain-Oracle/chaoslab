# phoenix-audit-agent local dev env — copy to .env and fill in.

# --- Hybrid Phoenix-hosting (ADR-017) ---------------------------------------
# 'phoenix-audit' (default, we host self-hosted Phoenix) or 'customer' (BYO key)
PHOENIX_PROVIDER=phoenix-audit

# Required in BYO mode (PHOENIX_PROVIDER=customer); empty in default mode.
# PHOENIX_API_KEY=

# Default points at infra/phoenix-self-host/ Docker. Override for Phoenix Cloud BYO.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# --- Judge LLM (ADR-007 — Flash mandatory) ----------------------------------
GEMINI_API_KEY=
JUDGE_LLM=gemini-3.5-flash

# --- Target + auxiliary ------------------------------------------------------
TARGET_DEFAULT_URL=http://localhost:8001
# GITLAB_TOKEN=
ENVIRONMENT=dev
SERVICE_VERSION=local
GCS_BUCKET=phoenix-audit-artifacts
