# phoenix-audit-agent local dev env — copy to .env and fill in.

# --- Hybrid Phoenix-hosting (ADR-017) ---------------------------------------
# 'phoenix-audit' (default, we host self-hosted Phoenix) or 'customer' (BYO key)
PHOENIX_PROVIDER=phoenix-audit

# Required in BYO mode (PHOENIX_PROVIDER=customer); empty in default mode.
# PHOENIX_API_KEY=

# Default points at infra/phoenix-self-host/ Docker. Override for Phoenix Cloud BYO.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# --- Judge LLM (ADR-007 — Flash mandatory) ----------------------------------
GEMINI_API_KEY=
JUDGE_LLM=gemini-3.5-flash

# --- Target + auxiliary ------------------------------------------------------
TARGET_DEFAULT_URL=http://localhost:8001

# Optional GitLab token. When set, the Patcher files a hardening-recipe MR
# on the target repo at the end of an audit. See ADR-011.
# GITLAB_TOKEN=

ENVIRONMENT=dev
SERVICE_VERSION=local

# --- Tests + local GCP -------------------------------------------------------
# Set RUN_ONLINE_TESTS=1 to enable @pytest.mark.online tests that hit real
# Gemini / Phoenix Cloud. Default off — they cost money.
# RUN_ONLINE_TESTS=0

# Local-dev GCP auth. For most workflows `gcloud auth application-default
# login` is enough; this is the escape hatch when you want to test the
# Secret Manager fallback path with a specific SA key.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json
