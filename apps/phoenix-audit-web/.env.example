# Phoenix Audit web — local dev env (copy to .env.local and fill in).

# Backend (phoenix-audit-agent) base URL. Local default:
AGENT_URL=http://localhost:8080

# Firebase client config (story-9.4). Public identifiers, not secrets —
# from `firebase.googleapis.com/v1beta1/projects/<id>/webApps/<app>/config`
# or the Firebase console. All three are required; auth fails closed without.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Session-cookie signing keys: comma-separated, each ≥32 bytes. Generate:
#   echo "$(openssl rand -hex 32),$(openssl rand -hex 32)"
# Deployed env reads the `cookie-signature-keys` Secret Manager secret.
AUTH_COOKIE_SIGNATURE_KEYS=

# next-firebase-auth-edge resolves the GCP project from this env var; without
# it (locally there is no metadata server) /api/login 500s on project lookup.
# Cloud Run sets it via the deploy workflow.
GOOGLE_CLOUD_PROJECT=

# KNOWN LOCAL LIMITATION: completing /api/login locally needs a custom-token
# signer. On Cloud Run the runtime SA signs keylessly (signBlob); locally the
# org policy `iam.disableServiceAccountKeyCreation` forbids SA keys, so the
# full sign-in round-trip is exercised on staging (or run the Firebase Auth
# emulator via FIREBASE_AUTH_EMULATOR_HOST for offline UI work). Everything
# else — route gating, redirects, error states, backend token verification —
# works locally.
